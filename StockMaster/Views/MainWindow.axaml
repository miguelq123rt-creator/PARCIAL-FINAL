<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StockMaster.Views.MainWindow"
        Title="StockMaster – Sistema de inventario"
        Width="1180" Height="760"
        MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FB">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">

    <!-- ========== ENCABEZADO ========== -->
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="StockMaster" FontSize="30" FontWeight="Bold" Foreground="#1E1B4B" />
      <TextBlock Text="Sistema de inventario para tu tienda" FontSize="14" Foreground="#6B7280" />
    </StackPanel>

    <!-- ========== TARJETAS DE RESUMEN ========== -->
    <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Margin="0,0,0,16">
      <Border Grid.Column="0" Classes="card" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Classes="statLabel" Text="Productos registrados" />
          <TextBlock x:Name="TxtTotalProductos" Classes="statValue" Text="0" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Classes="card" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Classes="statLabel" Text="Unidades en stock" />
          <TextBlock x:Name="TxtUnidades" Classes="statValue" Text="0" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Classes="card" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Classes="statLabel" Text="Valor del inventario" />
          <TextBlock x:Name="TxtValor" Classes="statValue" Text="$ 0.00" />
        </StackPanel>
      </Border>
      <Border Grid.Column="3" Classes="card">
        <StackPanel>
          <TextBlock Classes="statLabel" Text="Con stock bajo o agotado" />
          <TextBlock x:Name="TxtAlertas" Classes="statValue" Text="0" Foreground="#B45309" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- ========== ZONA PRINCIPAL: FORMULARIO + TABLA ========== -->
    <Grid Grid.Row="2" ColumnDefinitions="340,*">

      <!-- Formulario -->
      <Border Grid.Column="0" Classes="card" Margin="0,0,16,0">
        <ScrollViewer>
          <StackPanel>
            <TextBlock x:Name="TxtTituloForm" Text="Nuevo producto"
                       FontSize="18" FontWeight="Bold" Foreground="#1E1B4B" />

            <TextBlock Classes="label" Text="Nombre" />
            <TextBox x:Name="TxtNombre" Watermark="Ej. Cuaderno universitario" MaxLength="80" />

            <TextBlock Classes="label" Text="Categoría" />
            <TextBox x:Name="TxtCategoria" Watermark="Ej. Papelería" MaxLength="40" />

            <TextBlock Classes="label" Text="Precio" />
            <TextBox x:Name="TxtPrecio" Watermark="Ej. 12.50" MaxLength="12" />

            <TextBlock Classes="label" Text="Stock (unidades)" />
            <TextBox x:Name="TxtStock" Watermark="Ej. 20" MaxLength="7" />

            <!-- Mensaje de éxito o error -->
            <Border x:Name="MensajeBorder" IsVisible="False" CornerRadius="8"
                    Padding="12,10" Margin="0,16,0,0">
              <TextBlock x:Name="TxtMensaje" TextWrapping="Wrap" FontSize="13" />
            </Border>

            <Button x:Name="BtnGuardar" Content="Guardar producto" Classes="primary"
                    HorizontalAlignment="Stretch" Margin="0,16,0,0" Click="Guardar_Click" />

            <Grid ColumnDefinitions="*,*" Margin="0,10,0,0">
              <Button x:Name="BtnLimpiar" Grid.Column="0" Content="Nuevo / Limpiar" Classes="secondary"
                      HorizontalAlignment="Stretch" Margin="0,0,5,0" Click="Limpiar_Click" />
              <Button x:Name="BtnEliminar" Grid.Column="1" Content="Eliminar" Classes="danger"
                      HorizontalAlignment="Stretch" Margin="5,0,0,0" Click="Eliminar_Click" />
            </Grid>

            <TextBlock Text="Consejo: haz clic en un producto de la tabla para editarlo."
                       FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,14,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Tabla de productos -->
      <Border Grid.Column="1" Classes="card">
        <Grid RowDefinitions="Auto,*">

          <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
            <TextBlock Grid.Column="0" Text="Inventario" FontSize="18" FontWeight="Bold"
                       Foreground="#1E1B4B" VerticalAlignment="Center" Margin="0,0,16,0" />
            <TextBox x:Name="TxtBuscar" Grid.Column="1" Watermark="Buscar por nombre o categoría..."
                     TextChanged="Buscar_TextChanged" />
          </Grid>

          <Panel Grid.Row="1" Margin="0,12,0,0">
            <DataGrid x:Name="TablaProductos"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      CanUserSortColumns="True"
                      SelectionChanged="Tabla_SelectionChanged">
              <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
                <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="140" />
                <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat='$ {0:N2}'}" Width="110" />
                <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="80" />
                <DataGridTemplateColumn Header="Estado" Width="130">
                  <DataTemplate>
                    <Panel VerticalAlignment="Center" Margin="8,0">
                      <Border Classes="pill ok" IsVisible="{Binding TieneStockNormal}">
                        <TextBlock Text="Disponible" />
                      </Border>
                      <Border Classes="pill warn" IsVisible="{Binding TieneStockBajo}">
                        <TextBlock Text="Stock bajo" />
                      </Border>
                      <Border Classes="pill bad" IsVisible="{Binding EstaAgotado}">
                        <TextBlock Text="Agotado" />
                      </Border>
                    </Panel>
                  </DataTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="TxtSinDatos" IsVisible="False"
                       Text="No hay productos para mostrar."
                       Foreground="#9CA3AF" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Panel>
        </Grid>
      </Border>
    </Grid>

    <!-- ========== PIE ========== -->
    <TextBlock x:Name="TxtRuta" Grid.Row="3" FontSize="11" Foreground="#9CA3AF" Margin="0,12,0,0" />

  </Grid>
</Window>
