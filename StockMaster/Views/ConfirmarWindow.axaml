<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StockMaster.Views.ConfirmarWindow"
        Title="Confirmar eliminación"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="White">

  <StackPanel Margin="24" Spacing="18">
    <TextBlock Text="Confirmar eliminación" FontSize="18" FontWeight="Bold" Foreground="#1E1B4B" />
    <TextBlock x:Name="TxtMensaje" TextWrapping="Wrap" Foreground="#4B5563" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Content="Cancelar" Classes="secondary" Click="No_Click" />
      <Button Content="Sí, eliminar" Classes="danger" Click="Si_Click" />
    </StackPanel>
  </StackPanel>

</Window>
